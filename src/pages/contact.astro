---
import BaseLayout from '../layouts/BaseLayout.astro';
const enabled = import.meta.env.CONTACT_ENABLED === 'true';
const bookingEnabled = import.meta.env.BOOKING_ENABLED === 'true';
const bookingUrl = import.meta.env.BOOKING_URL || '';
---
<BaseLayout title="Contact — Stewsac Inc." description="Contact Stewsac Inc. by secure inquiry form or request a consultation.">
  <h1>Contact Stewsac Inc.</h1>
  <p>Business email: <a href="mailto:support@stewsac.com">support@stewsac.com</a></p>

  <h2>Send an inquiry</h2>
  {enabled ? (
    <form id="inquiry" novalidate aria-describedby="form-status">
      <label for="name">Name</label><input id="name" name="name" type="text" autocomplete="name" required />
      <label for="email">Business email</label><input id="email" name="email" type="email" autocomplete="email" required />
      <label for="company">Company</label><input id="company" name="company" type="text" autocomplete="organization" />
      <label for="message">Message</label><textarea id="message" name="message" required></textarea>
      <label><input type="checkbox" name="privacy" required /> I acknowledge the <a href="/privacy/">privacy notice</a>.</label>
      <button class="btn btn-primary" type="submit">Send inquiry</button>
      <p id="form-status" role="status"></p>
    </form>
    <script is:inline>
      // JSON fetch; server validates JSON. No HTML-encoded POST to the JSON endpoint.
      const f = document.getElementById('inquiry');
      const s = document.getElementById('form-status');
      f.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        s.textContent = 'Sending…';
        const data = Object.fromEntries(new FormData(f).entries());
        data.privacy = data.privacy ? 'on' : '';
        try {
          const r = await fetch('/api/contact', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify(data) });
          if (r.status === 202) { s.textContent = 'Thank you — your inquiry has been received.'; f.reset(); return; }
          if (r.status === 503) { s.textContent = 'The inquiry form is temporarily unavailable. Please email support@stewsac.com.'; return; }
          if (r.status === 422) { s.textContent = 'Please check the required fields and try again.'; return; }
          if (r.status === 429) { s.textContent = 'Too many attempts. Please try again later or email support@stewsac.com.'; return; }
          s.textContent = 'Something went wrong. Please email support@stewsac.com.';
        } catch { s.textContent = 'Network error. Please email support@stewsac.com.'; }
      });
    </script>
  ) : (
    <p class="notice">The secure inquiry form is not enabled. Please email <a href="mailto:support@stewsac.com">support@stewsac.com</a>.</p>
  )}

  <h2>Request a consultation</h2>
  {bookingEnabled && bookingUrl ? (
    <p><a class="btn btn-secondary" href={bookingUrl} rel="noopener noreferrer">Request a consultation</a></p>
  ) : (
    <p class="notice">Online consultation booking is not enabled. Please email <a href="mailto:support@stewsac.com">support@stewsac.com</a> to request a consultation.</p>
  )}
</BaseLayout>
